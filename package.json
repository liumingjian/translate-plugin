{
  "name": "translate-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "e2e:icon": "node scripts/icon.e2e.mjs",
    "e2e:screenshot": "vite build --mode e2e && node scripts/screenshot.e2e.mjs",
    "e2e:lifecycle": "vite build --mode e2e && node scripts/lifecycle.e2e.mjs",
    "e2e:workspace": "vite build --mode e2e && node scripts/workspace.e2e.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "puppeteer-core": "^25.7.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
